<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F5F7"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="8dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/library"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="#17191D" />
            <ImageButton
                android:id="@+id/add_library"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="12dp"
                android:background="@drawable/nav_circle"
                android:src="@drawable/icon_create"
                android:contentDescription="@string/add_library" />
            <ImageButton
                android:id="@+id/search"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="12dp"
                android:background="@drawable/nav_circle"
                android:src="@drawable/icon_search"
                android:contentDescription="@string/search" />
        </LinearLayout>

        <TextView
            android:id="@+id/library_search_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="#626873"
            android:visibility="gone" />

        <include layout="@layout/view_live_conditions" />

        <RadioGroup
            android:id="@+id/library_filters"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:padding="3dp"
            android:orientation="horizontal"
            android:background="@drawable/filter_bar"
            android:checkedButton="@id/filter_active">
            <RadioButton
                android:id="@+id/filter_active"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:button="@null"
                android:background="@drawable/filter_option"
                android:gravity="center"
                android:padding="0dp"
                android:text="@string/filter_active"
                android:textColor="@color/filter_text"
                android:textSize="12sp" />
            <RadioButton
                android:id="@+id/filter_hidden"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:button="@null"
                android:background="@drawable/filter_option"
                android:gravity="center"
                android:padding="0dp"
                android:text="@string/filter_hidden"
                android:textColor="@color/filter_text"
                android:textSize="12sp" />
            <RadioButton
                android:id="@+id/filter_all"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:button="@null"
                android:background="@drawable/filter_option"
                android:gravity="center"
                android:padding="0dp"
                android:text="@string/filter_all"
                android:textColor="@color/filter_text"
                android:textSize="12sp" />
        </RadioGroup>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1">
            <LinearLayout
                android:id="@+id/library_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>
</FrameLayout>
