<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F5F7"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/library"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="#17191D" />
            <ImageButton
                android:id="@+id/add_library"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="12dp"
                android:background="@drawable/nav_circle"
                android:src="@drawable/icon_create"
                android:contentDescription="@string/add_library" />
            <ImageButton
                android:id="@+id/search"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="12dp"
                android:background="@drawable/nav_circle"
                android:src="@drawable/icon_search"
                android:contentDescription="@string/search" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="#DDE1E7"
            app:strokeWidth="1dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:orientation="vertical">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <View
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/green_dot"
                        android:importantForAccessibility="no" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/live_conditions"
                        android:textColor="#17191D"
                        android:textStyle="bold"
                        android:textSize="11sp" />
                </LinearLayout>
                <TextClock
                    android:id="@+id/live_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"
                    android:background="@drawable/time_badge"
                    android:timeZone="America/New_York"
                    android:format12Hour="h:mm a 'ET'"
                    android:format24Hour="HH:mm 'ET'"
                    android:textColor="#2E7D32"
                    android:textSize="12sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <RadioGroup
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:padding="4dp"
            android:orientation="horizontal"
            android:background="@drawable/filter_bar"
            android:checkedButton="@id/filter_active">
            <RadioButton
                android:id="@+id/filter_active"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:button="@null"
                android:background="@drawable/filter_option"
                android:gravity="center"
                android:padding="0dp"
                android:text="@string/filter_active"
                android:textColor="@color/filter_text"
                android:textSize="12sp" />
            <RadioButton
                android:id="@+id/filter_hidden"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:button="@null"
                android:background="@drawable/filter_option"
                android:gravity="center"
                android:padding="0dp"
                android:text="@string/filter_hidden"
                android:textColor="@color/filter_text"
                android:textSize="12sp" />
            <RadioButton
                android:id="@+id/filter_all"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:button="@null"
                android:background="@drawable/filter_option"
                android:gravity="center"
                android:padding="0dp"
                android:text="@string/filter_all"
                android:textColor="@color/filter_text"
                android:textSize="12sp" />
        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/no_libraries"
            android:textColor="#626873"
            android:textSize="18sp" />
    </LinearLayout>
</FrameLayout>
